# ---- Adways Doubt-Clearing Platform — server env ----
# Copy to server/.env and fill in. Blank values count as unset.

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5174

# Postgres. Local dev: use the embedded DB (npm run db:local) then:
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/doubts?schema=public
# Supabase prod uses the transaction pooler (6543, pgbouncer=true) at runtime and
# the session pooler (5432) for migrations. In Supabase everything is in schema `public`.
DIRECT_URL=

# Tests need a SEPARATE database from DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/doubts?schema=doubts_test

# ---- Auth ----
SESSION_COOKIE_NAME=adways_doubts_sid
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false

# Pre-seeded admins (NEVER self-service). JSON array; run `npm run seed:admins`.
# ADMIN_SEED=[{"email":"admin@adwaysacademy.com","name":"Admin","password":"change-me-strong","role":"SUPER_ADMIN"}]
ADMIN_SEED=

# ---- AI (Groq, OpenAI-compatible) ----
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_DAILY_BUDGET_USD=5

# ---- Embeddings ----
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Email (Resend recommended; SMTP for Hostinger/SendGrid; console = dev log) ----
EMAIL_PROVIDER=console
EMAIL_FROM=Adways Academy <no-reply@adwaysacademy.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- WhatsApp (official Business Cloud API only) ----
WHATSAPP_ENABLED=false
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Storage (private uploads) ----
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=doubts-private

# ---- Worker ----
WORKER_ENABLED=true
WORKER_POLL_MS=1500

# ---- Limits & retention ----
MAX_UPLOAD_MB=8
STUDENT_RATE_PER_HOUR=30
RETENTION_DAYS=365

ENABLE_DEV_ROUTES=true

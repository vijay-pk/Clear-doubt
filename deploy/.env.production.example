# Copy to deploy/.env on the VPS and fill in. Use the SAME values you set on
# Render (especially the Supabase ones) so the app keeps the existing data.
# deploy/.env is git-ignored — never commit real secrets.

NODE_ENV=production
PORT=3001
APP_URL=https://doubts.adwaysacademy.com
COOKIE_SECURE=true
TRUST_PROXY=true
WORKER_ENABLED=true
ENABLE_DEV_ROUTES=false

# ---- Supabase (SAME as Render — this is where your data lives) ----
# Runtime uses the transaction pooler (6543, pgbouncer=true); migrations use the
# session pooler (5432). URL-encode special characters in the password.
DATABASE_URL=
DIRECT_URL=
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=doubts-private

# ---- Admins (idempotent on boot; skips existing emails) ----
ADMIN_SEED=

# ---- AI (Groq) ----
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_DAILY_BUDGET_USD=5

# ---- Embeddings (leave provider=none for keyword-only, no key needed) ----
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Email (optional; set up Resend later) ----
EMAIL_PROVIDER=console
EMAIL_FROM=Adways Academy <no-reply@adwaysacademy.com>
RESEND_API_KEY=

# ---- WhatsApp (optional) ----
WHATSAPP_ENABLED=false
WHATSAPP_WEB_SESSION_DIR=./wa-session

# ---- Limits ----
MAX_UPLOAD_MB=8
STUDENT_RATE_PER_HOUR=30
RETENTION_DAYS=365
